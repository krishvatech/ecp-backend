# Django core settings
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres)
POSTGRES_DB=ecp
POSTGRES_USER=ecp
POSTGRES_PASSWORD=ecp_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (broker, cache, channels)
REDIS_URL=redis://redis:6379/0

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000

# DRF throttling
DRF_THROTTLE_ANON=10/min
DRF_THROTTLE_USER=100/min

# Moderation
MODERATION_AUTO_REVIEW_THRESHOLD=3

# LinkedIn profile import (AI) request timeouts in seconds.
# Large LinkedIn PDF exports need a long read timeout; raise it if imports
# still report "AI service timed out".
LINKEDIN_PROFILE_IMPORT_AI_CONNECT_TIMEOUT=10
LINKEDIN_PROFILE_IMPORT_AI_READ_TIMEOUT=90

# Storage configuration (S3 or GCS). Leave empty if unused.
# AWS S3
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
# Google Cloud Storage
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Simple JWT lifetimes
SIMPLE_JWT_ACCESS_LIFETIME_MIN=30
SIMPLE_JWT_REFRESH_LIFETIME_DAYS=7

# Secure Cognito member session (Issue #5)
# Keep disabled until migration, shared encryption key, Cloudflare /_auth/* Worker,
# and frontend secure-session rollout are ready.
SECURE_AUTH_SESSION_ENABLED=false
# Fernet key(s), comma-separated. Store production value in SSM SecureString.
SECURE_AUTH_TOKEN_ENCRYPTION_KEY=
SECURE_AUTH_SESSION_TTL_DAYS=30
SECURE_AUTH_COOKIE_NAME=__Host-ecp_secure_session
SECURE_AUTH_COOKIE_SECURE=true
SECURE_AUTH_COOKIE_SAMESITE=Strict
SECURE_AUTH_ALLOWED_ORIGINS=http://localhost:5173
SECURE_AUTH_SESSION_THROTTLE_RATE=30/min

# Saleor Integration
SALEOR_ENABLED=false
# When SALEOR_ENABLED=false, the following settings are not required
SALEOR_API_URL=http://localhost:8001/graphql/
SALEOR_DASHBOARD_URL=http://127.0.0.1:9001/
SALEOR_TOKEN_ENCRYPTION_KEY=replace-with-a-stable-random-secret
SALEOR_ECP_CALLBACK_URL=http://127.0.0.1:8000/api/auth/saleor/callback/
FRONTEND_SALEOR_MANAGER_URL=http://localhost:5173/admin/saleor
SALEOR_WEBHOOK_SECRET=replace-me

# Saleor SSO via Cognito (Hosted UI)
# Example domain: https://your-domain.auth.eu-central-1.amazoncognito.com
COGNITO_DOMAIN=
COGNITO_SALEOR_CLIENT_ID=
COGNITO_SALEOR_REDIRECT_URI=
COGNITO_SALEOR_SCOPES=openid email profile
SALEOR_SSO_PROMPT=none

# Edwiser Bridge Integration (imaa-institute.org — course catalogue & enrollments)
# Application Password: WP Admin → Users → Profile → Application Passwords
EB_WP_API_URL=https://imaa-institute.org/wp-json
EB_WP_API_USER=
EB_WP_API_PASSWORD=
EB_WP_AUTH_TYPE=basic

# WordPress Blog import (public REST API, read-only; used by import_wordpress_blogs)
WP_IMAA_BLOG_BASE_URL=https://imaa-institute.org
WP_IMAA_BLOG_CATEGORY_ID=58
WP_IMAA_BLOG_CATEGORY_SLUG=blog
WP_IMAA_BLOG_TIMEOUT=20

# Email / invoice notifications
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="IMAA Connect <no-reply@example.com>"
DEFAULT_REPLY_TO_EMAIL=
SUPPORT_EMAIL=
# false = send immediately from admin mark-paid request; true = send via Celery worker
INVOICE_EMAIL_ASYNC=false
FRONTEND_URL=http://localhost:5173/
# Public backend URL used for signed invoice download links in emails
# Example local: http://localhost:8000
# Example production: https://api.yourdomain.com
INVOICE_PUBLIC_BASE_URL=http://localhost:8000
INVOICE_PUBLIC_DOWNLOAD_MAX_AGE_DAYS=30

# MANDA -> IMAA Connect event integration
# Must match MANDA backend IMAA_CONNECT_MANDA_INTEGRATION_SECRET.
MANDA_INTEGRATION_SECRET=
# IMAA Connect community used for events synced from MANDA.
MANDA_SYNC_DEFAULT_COMMUNITY_ID=
# Optional numeric Django user ID. Leave this unset/empty to use the community
# owner above. Do not set this to text such as none, null, or undefined.
MANDA_SYNC_DEFAULT_USER_ID=


# IMAA Connect -> MANDA event integration
# Must match MANDA backend IMAA_CONNECT_INTEGRATION_SECRET.
MANDA_API_BASE_URL=http://127.0.0.1:8000
MANDA_API_INTEGRATION_SECRET=
MANDA_API_TIMEOUT=20


# Event platform sync automation
EVENT_PLATFORM_SYNC_AUTO_ENABLED=true
EVENT_PLATFORM_SYNC_INTERVAL_SECONDS=60
EVENT_PLATFORM_SYNC_BATCH_SIZE=50
EVENT_PLATFORM_SYNC_TRIGGER_ON_COMMIT=true


# ECP -> Mautic identity assertions (Phase 1 foundation; not used by live calls yet)
# RS256 private key PEM (2048+ bits). Store in the secret manager; literal "\n" is accepted.
# The matching PUBLIC key is configured in ECP Mautic, never this private key.
ECP_MAUTIC_IDENTITY_PRIVATE_KEY=
ECP_MAUTIC_IDENTITY_KEY_ID=
ECP_MAUTIC_IDENTITY_ISSUER=ecp
ECP_MAUTIC_IDENTITY_AUDIENCE=ecp-mautic
ECP_MAUTIC_IDENTITY_TTL_SECONDS=90
# Phase 2: execute manual campaign create/update as the mapped Mautic user.
# Keep false unless identity keys and user mappings are configured.
ECP_MAUTIC_PER_USER_EXECUTION_ENABLED=false
